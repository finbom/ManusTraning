<Window x:Class="ManusReader.Dialogs.TtsSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TTS-inställningar"
        Width="460" Height="580"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="InfoText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="20,0,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Välj TTS-motor:" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,14"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- ===== NATURAL ===== -->
            <RadioButton x:Name="RadioNatural" GroupName="Provider"
                         FontWeight="SemiBold" FontSize="12"
                         Checked="Provider_Changed">
                Naturliga röster (Windows)
                <RadioButton.ToolTip>Kräver inga kontouppgifter. Fungerar offline.</RadioButton.ToolTip>
            </RadioButton>
            <TextBlock Style="{StaticResource InfoText}" Margin="20,4,0,4"
                       Text="Gratis, lokalt och offline. Tillgängliga röster beror på vad som är installerat i Windows."/>
            <TextBlock Style="{StaticResource InfoText}"
                       Text="Installera fler röster: Inställningar → Tid &amp; språk → Tal → Lägg till röster"/>

            <Border x:Name="NaturalPanel" Margin="20,8,0,14"
                    BorderBrush="#CCC" BorderThickness="1" CornerRadius="4"
                    Padding="10" Background="#FAFAFA">
                <StackPanel>
                    <TextBlock Text="Installerade röster:" FontSize="11" Margin="0,0,0,4"/>
                    <ListBox x:Name="NaturalVoicesList" Height="80" FontSize="11"
                             BorderBrush="#DDD" SelectionMode="Single"/>
                    <Button Content="🔊  Testa vald röst" Margin="0,8,0,0"
                            Padding="8,4" HorizontalAlignment="Left" FontSize="11"
                            Click="TestNatural_Click"/>
                </StackPanel>
            </Border>

            <!-- ===== AZURE ===== -->
            <RadioButton x:Name="RadioAzure" GroupName="Provider"
                         FontWeight="SemiBold" FontSize="12"
                         Checked="Provider_Changed">
                Azure Neural TTS
            </RadioButton>
            <TextBlock Style="{StaticResource InfoText}" Margin="20,4,0,8"
                       Text="Högre kvalitet. Kräver Azure-konto och internetanslutning."/>

            <Border x:Name="AzurePanel" Margin="20,0,0,0"
                    BorderBrush="#CCC" BorderThickness="1" CornerRadius="4"
                    Padding="10" Background="#FAFAFA">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Prenumerationsnyckel:"
                               VerticalAlignment="Center" FontSize="11"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="AzureKeyBox"
                             Margin="0,0,0,6" FontSize="11" Padding="3,2"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Region:"
                               VerticalAlignment="Center" FontSize="11"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="AzureRegionBox"
                             Margin="0,0,0,6" FontSize="11" Padding="3,2"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Språk:"
                               VerticalAlignment="Center" FontSize="11"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="AzureLanguageBox"
                             Margin="0,0,0,10" FontSize="11" Padding="3,2"/>

                    <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal">
                        <Button Content="🔊  Testa Azure-anslutning"
                                Padding="8,4" FontSize="11" Margin="0,0,8,0"
                                Click="TestAzure_Click"/>
                        <Button Content="❓  Hjälp"
                                Padding="8,4" FontSize="11"
                                Click="AzureHelp_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
        </ScrollViewer>

        <!-- ===== BUTTONS ===== -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Button Content="Återställ Azure-konfiguration" HorizontalAlignment="Left"
                    Padding="8,4" FontSize="11" Foreground="DarkRed"
                    Click="ResetAzure_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="OK" Width="80" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"/>
                <Button Content="Avbryt" Width="80" IsCancel="True" Click="Cancel_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
