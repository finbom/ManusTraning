<Window x:Class="ManusReader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ManusReader" Height="750" Width="1150"
        MinHeight="500" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,2"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="Background" Value="#FAFAFA"/>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- ===== MENY ===== -->
        <Menu DockPanel.Dock="Top" Background="#F0F0F0">
            <MenuItem Header="Arkiv">
                <MenuItem Header="Öppna manus (txt)..." Click="OpenScript_Click" InputGestureText="Ctrl+O"/>
                <MenuItem Header="Öppna Word-manus..." Click="OpenWord_Click" InputGestureText="Ctrl+W"/>
                <MenuItem Header="Öppna Word-manus med AI (Ollama)..." Click="OpenWordWithAI_Click"/>
                <Separator/>
                <MenuItem Header="Öppna projekt..." Click="OpenProject_Click"/>
                <Separator/>
                <MenuItem Header="Spara projekt" Click="SaveProject_Click" InputGestureText="Ctrl+S"/>
                <MenuItem Header="Spara projekt som..." Click="SaveProjectAs_Click"/>
                <Separator/>
                <MenuItem Header="Avsluta" Click="Exit_Click" InputGestureText="Alt+F4"/>
            </MenuItem>
            <MenuItem Header="Inställningar">
                <MenuItem Header="TTS-inställningar..." Click="OpenTtsSettings_Click" InputGestureText="Ctrl+T"/>
            </MenuItem>
            <MenuItem Header="Hjälp">
                <MenuItem Header="Om ManusReader..." Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- ===== VERKTYGSFÄLT ===== -->
        <ToolBar DockPanel.Dock="Top" Background="#E8E8E8" Padding="4,2">
            <Button Click="OpenScript_Click" Padding="8,4" ToolTip="Öppna en textfil med manus (Ctrl+O)">
                📄 Öppna manus
            </Button>
            <Button Click="OpenWord_Click" Padding="8,4" ToolTip="Öppna Word-manus och identifiera roller automatiskt (Ctrl+W)">
                📝 Öppna Word
            </Button>
            <Button Click="OpenWordWithAI_Click" Padding="8,4" ToolTip="Öppna Word-manus och analysera roller med AI lokalt (Ollama)">
                🤖 Öppna Word+AI
            </Button>
            <Button Click="OpenProject_Click" Padding="8,4" ToolTip="Öppna ett sparat projekt (.mrp)">
                📂 Öppna projekt
            </Button>
            <Button Click="SaveProject_Click" Padding="8,4" ToolTip="Spara aktuellt projekt">
                💾 Spara projekt
            </Button>
            <Separator/>
            <Button x:Name="StartStopButton" Click="StartStop_Click"
                    Padding="14,6" FontWeight="Bold" FontSize="13"
                    Background="#4CAF50" Foreground="White"
                    BorderBrush="#388E3C"
                    ToolTip="Starta/stoppa manusläsning (Space = nästa replik)">
                ▶  Starta manusläsning
            </Button>
            <Separator/>
            <TextBlock VerticalAlignment="Center" Margin="6,0" Foreground="#666"
                       FontSize="11" Text="[Mellanslag] = Nästa replik"/>
        </ToolBar>

        <!-- ===== STATUSFÄLT ===== -->
        <StatusBar DockPanel.Dock="Bottom" Background="#E0E0E0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Öppna ett manus för att börja" FontSize="11"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Stretch">
                <TextBlock x:Name="CurrentLineText" Text="" FontSize="11"
                           FontStyle="Italic" Foreground="#444" TextTrimming="CharacterEllipsis"
                           MaxWidth="700"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="ProgressText" Text="" FontSize="11" Foreground="#666"/>
            </StatusBarItem>
        </StatusBar>

        <!-- ===== HUVUD-GRID ===== -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" MinWidth="220"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- ==================== VÄNSTER PANEL: ROLLER ==================== -->
            <DockPanel Grid.Column="0" Margin="6,6,3,6">

                <TextBlock DockPanel.Dock="Top" Style="{StaticResource HeaderStyle}"
                           Text="Roller i manuset"/>

                <!-- RÖSTPROFIL-REDIGERARE (neddockad) -->
                <Border DockPanel.Dock="Bottom" Style="{StaticResource PanelBorder}">
                    <StackPanel x:Name="VoiceProfileEditor" IsEnabled="False">

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SelectedRoleLabel" Grid.Column="0"
                                       Text="— välj en roll ovan —"
                                       FontWeight="Bold" FontSize="12"
                                       Foreground="#333" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="✏ Byt namn"
                                    Padding="5,2" FontSize="10"
                                    Click="RenameRole_Click"
                                    ToolTip="Byt namn på rollen – uppdaterar alla repliker i manuset"/>
                        </Grid>

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Röst:"/>
                        <ComboBox x:Name="VoiceComboBox" Margin="0,0,0,6"
                                  SelectionChanged="VoiceComboBox_SelectionChanged"/>

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Kön / Karaktär:"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <RadioButton x:Name="GenderMan" Content="Man" GroupName="Gender"
                                         Margin="0,0,12,0" Checked="Gender_Checked"/>
                            <RadioButton x:Name="GenderKvinna" Content="Kvinna" GroupName="Gender"
                                         Margin="0,0,12,0" Checked="Gender_Checked"/>
                            <RadioButton x:Name="GenderBarn" Content="Barn" GroupName="Gender"
                                         Checked="Gender_Checked"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="45"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource LabelStyle}" Text="Tempo:"/>
                            <TextBlock Grid.Column="1" x:Name="TempoValueLabel" Text="0%"
                                       HorizontalAlignment="Right" FontSize="11" Margin="0,4,0,0"/>
                        </Grid>
                        <Slider x:Name="TempoSlider" Minimum="-50" Maximum="50" Value="0"
                                TickFrequency="25" IsSnapToTickEnabled="False" Margin="0,0,0,8"
                                ValueChanged="TempoSlider_ValueChanged"/>

                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="45"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource LabelStyle}" Text="Pitch:"/>
                            <TextBlock Grid.Column="1" x:Name="PitchValueLabel" Text="0%"
                                       HorizontalAlignment="Right" FontSize="11" Margin="0,4,0,0"/>
                        </Grid>
                        <Slider x:Name="PitchSlider" Minimum="-50" Maximum="50" Value="0"
                                TickFrequency="25" IsSnapToTickEnabled="False" Margin="0,0,0,10"
                                ValueChanged="PitchSlider_ValueChanged"/>

                        <Button Content="🔊  Testa röst" Click="TestVoice_Click"
                                Padding="8,5" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- ROLLISTA -->
                <ListBox x:Name="RolesListBox"
                         Margin="0,0,0,0"
                         SelectionChanged="RolesListBox_SelectionChanged"
                         MouseDoubleClick="RolesListBox_MouseDoubleClick"
                         BorderBrush="#CCCCCC">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="2,3">
                                <TextBlock Text="{Binding RoleName}" FontWeight="SemiBold" MinWidth="120"/>
                                <TextBlock Text=" — " Foreground="#888"/>
                                <TextBlock Text="{Binding VoiceName}" Foreground="#555" FontSize="10"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- SPLITTER -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="#CCCCCC"/>

            <!-- ==================== HÖGER PANEL: MANUSLISTAN ==================== -->
            <DockPanel Grid.Column="2" Margin="3,6,6,6">

                <!-- Header + knappar -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock Style="{StaticResource HeaderStyle}"
                               Text="Manus — repliker" DockPanel.Dock="Left"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Markera alla" Click="SelectAll_Click"
                                Padding="7,3" Margin="0,0,4,0" FontSize="11"/>
                        <Button Content="Avmarkera alla" Click="DeselectAll_Click"
                                Padding="7,3" Margin="0,0,4,0" FontSize="11"/>
                        <Button Content="↩ Hoppa till aktuell" Click="ScrollToCurrent_Click"
                                Padding="7,3" FontSize="11"/>
                    </StackPanel>
                </DockPanel>

                <!-- Script DataGrid -->
                <DataGrid x:Name="ScriptDataGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          RowBackground="White"
                          AlternatingRowBackground="#F5F5F5"
                          BorderBrush="#CCCCCC"
                          FontSize="12"
                          ContextMenuOpening="ScriptDataGrid_ContextMenuOpening">

                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="▶ Börja läsa härifrån" Click="StartFromHere_Click"/>
                            <Separator/>
                            <MenuItem Header="🏷 Tilldela roll till markerad rad..." Click="AssignRole_Click"/>
                            <Separator/>
                            <MenuItem Header="Markera replik som ska läsas" Click="MarkShouldRead_Click"/>
                            <MenuItem Header="Avmarkera replik" Click="MarkShouldNotRead_Click"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>

                    <DataGrid.Columns>
                        <!-- Checkbox-kolumn: enkel-klick via template -->
                        <DataGridTemplateColumn Header="Läs upp" Width="65" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding ShouldRead, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Roll" Binding="{Binding RoleName}"
                                            Width="130" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="2,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Replik" Binding="{Binding Text}"
                                            Width="*" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="2,3"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <!-- Aktuell replik: gul bakgrund -->
                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                    <Setter Property="Background" Value="#FFF176"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="BorderBrush" Value="#F9A825"/>
                                    <Setter Property="BorderThickness" Value="0,2"/>
                                </DataTrigger>
                                <!-- Scenanvisning: grå/kursiv -->
                                <DataTrigger Binding="{Binding IsStageDirection}" Value="True">
                                    <Setter Property="Foreground" Value="#888"/>
                                    <Setter Property="FontStyle" Value="Italic"/>
                                </DataTrigger>
                                <!-- Okänd roll: orange bakgrund -->
                                <DataTrigger Binding="{Binding IsUnknown}" Value="True">
                                    <Setter Property="Background" Value="#FFE0B2"/>
                                    <Setter Property="BorderBrush" Value="#FF6F00"/>
                                    <Setter Property="BorderThickness" Value="0,1"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
